ptop() {
    cat >> $IBK_OUT <<EOF
<!DOCTYPE html>
<html>

<head>
    <title> $BLOG_TITLE - ↓ segmentation success </title>
    <link rel="stylesheet" href="https://kevadesu.github.io/echostyle/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fragment+Mono:ital@0;1&display=swap"
    rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
</head>

<body class="desk" style="background-image: url('$BG');">
    <div class="window">
        <a href="../index.html">↓ segmentation success</a>
        <h1><i><u>$BLOG_TITLE</u></i></h1>
        <small>$BLOG_DATE</small>
EOF
}

pbottom() {
    cat >> $IBK_OUT <<EOF
        <a class="button" href="../index.html">Return to blog index</a>
    </div>
</body>
</html>
EOF
}