PROJECT_DIR=$(dirname "$0")

init
meta
    meta.title "↓ segmentation success"
    # echostyle
    css "https://kevadesu.github.io/echostyle/style.css"
    meta.link "rel=\"preconnect\" href=\"https://fonts.googleapis.com\""
    meta.link "rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin"
    css "https://fonts.googleapis.com/css2?family=Fragment+Mono:ital@0;1&display=swap"
    meta.m "name='viewport' content='width=device-width, initial-scale=1.0'"
    meta.m "charset='UTF-8'"
meta.end
content
    t "<style>
        /* theme equals catppuccin */

        .window {
            background-color: #dce0e8d8;
            color: #4c4f69
        }

        button,
        .button {
            background-color: #4c4f69;
            color: #dce0e8;
        }

        button:hover,
        .button:hover {
            background-color: #8839ef;
            color: #dce0e8;
        }

        @media (prefers-color-scheme: dark) {
            .window {
                background-color: #11111bd8;
                color: #cdd6f4
            }

            button,
            .button {
                background-color: #cdd6f4;
                color: #11111b;
            }

            button:hover,
            .button:hover {
                background-color: #cba6f7;
                color: #11111b;
            }
        }

        @media (prefers-color-scheme: dark) {
            .album-photo {
                border: dotted #cba6f7 5px;
            }
        }
    </style>"
    con "class=\"desk\" style=\"background-image: url('assets/bg.jpg');\""
        con "class=\"window\""
            heading1 "↓ segmentation success"
            t "<small>the first blog written with IBK-Lang</small>"

            heading3 "→ posts"
            for file in $(ls "$PROJECT_DIR"/src/posts/*.ibkx | sort -r); do
                FILENAME=$(echo $file | sed -e 's/\.ibkx$/.html/' -e 's#/src##')
                eval "$(grep '^BLOG_TITLE=' "$file")"
                eval "$(grep '^BLOG_DATE=' "$file")"
                hyperlink "href=\"$FILENAME\" class=\"button\" style=\"display: inline-block; box-sizing: border-box; text-align: left;\"" "$BLOG_TITLE &middot; $BLOG_DATE"; t "<br>"
            done
            hyperlink "href=\"https://kevadesu.github.io\"" "a blog by kevadesu"
        con.end
    con.end
content.end